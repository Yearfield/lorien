# Security Configuration for Lorien API
# Copy this file to security.env and configure for your environment

# Environment Configuration
ENVIRONMENT=development  # Options: development, production, staging
AUTH_REQUIRED=false      # Set to true to require authentication

# Authentication
AUTH_TOKEN=your-secure-token-here  # Required for production
AUTH_SESSION_TIMEOUT=3600          # Session timeout in seconds (default: 1 hour)

# Rate Limiting
RATE_LIMIT_ENABLED=false           # Enable rate limiting
RATE_LIMIT_REQUESTS=100            # Requests per window (default: 100)
RATE_LIMIT_WINDOW=3600             # Window in seconds (default: 1 hour)

# CORS Configuration
CORS_ORIGINS=*                     # Comma-separated origins or * for all
CORS_ALLOW_CREDENTIALS=false       # Allow credentials in CORS requests

# Security Headers
SECURITY_HEADERS_ENABLED=false     # Enable security headers
HSTS_MAX_AGE=31536000              # HSTS max age in seconds (default: 1 year)
CONTENT_SECURITY_POLICY=default-src 'self'  # CSP header value

# Input Validation
INPUT_VALIDATION_ENABLED=true      # Enable input validation
MAX_REQUEST_SIZE=10485760          # Max request size in bytes (default: 10MB)

# Security Logging
SECURITY_LOGGING_ENABLED=true      # Enable security event logging
LOG_FAILED_AUTH_ATTEMPTS=true      # Log failed authentication attempts

# Production Security Recommendations:
# ENVIRONMENT=production
# AUTH_REQUIRED=true
# AUTH_TOKEN=your-very-secure-random-token-here
# RATE_LIMIT_ENABLED=true
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# CORS_ALLOW_CREDENTIALS=false
# SECURITY_HEADERS_ENABLED=true
# HSTS_MAX_AGE=31536000
# CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'
# INPUT_VALIDATION_ENABLED=true
# MAX_REQUEST_SIZE=10485760
# SECURITY_LOGGING_ENABLED=true
# LOG_FAILED_AUTH_ATTEMPTS=true
