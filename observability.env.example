# ============================================================================
# Observability Configuration Example
# ============================================================================
#
# This file contains example configuration for Lorien's observability features:
# - Structured JSON logging
# - Request/trace IDs
# - Metrics collection
# - OpenTelemetry integration
#
# Copy relevant settings to your .env file or export them in your environment.
# ============================================================================

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable JSON-structured logging (true/false)
# When true: logs are output as JSON for machine parsing
# When false: logs use traditional text format
JSON_LOGGING=true

# ----------------------------------------------------------------------------
# Metrics & Analytics
# ----------------------------------------------------------------------------

# Enable metrics collection (true/false)
# Required for /api/v1/health/metrics endpoint
ANALYTICS_ENABLED=true

# Authentication token for metrics endpoint
# Generate with: openssl rand -hex 32
# Required when accessing /api/v1/health/metrics
AUTH_TOKEN=your-secret-token-here

# ----------------------------------------------------------------------------
# OpenTelemetry (Optional)
# ----------------------------------------------------------------------------

# OpenTelemetry collector endpoint (OTLP over gRPC)
# Examples:
#   - Local Jaeger: http://localhost:4317
#   - Local OTEL Collector: http://localhost:4317
#   - Datadog: https://api.datadoghq.com
#   - New Relic: https://otlp.nr-data.net:4317
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# OpenTelemetry headers (comma-separated key=value pairs)
# Examples:
#   - Datadog: api-key=YOUR_API_KEY
#   - New Relic: api-key=YOUR_LICENSE_KEY
#   - Grafana Cloud: Authorization=Basic YOUR_BASE64_CREDENTIALS
# OTEL_EXPORTER_OTLP_HEADERS=api-key=your-api-key

# Metrics export interval in milliseconds (default: 60000 = 60 seconds)
# OTEL_METRIC_EXPORT_INTERVAL=60000

# Custom resource attributes (use OTEL_RESOURCE_ATTRIBUTES_* prefix)
# These are converted to resource attributes by removing the prefix
# Examples:
# OTEL_RESOURCE_ATTRIBUTES_ENVIRONMENT=production
# OTEL_RESOURCE_ATTRIBUTES_DATACENTER=us-east-1
# OTEL_RESOURCE_ATTRIBUTES_TEAM=platform
# OTEL_RESOURCE_ATTRIBUTES_VERSION=1.0.0

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------

# Database path (for health checks and metrics)
LORIEN_DB_PATH=~/.local/share/lorien/app.db

# ----------------------------------------------------------------------------
# Example Configurations
# ----------------------------------------------------------------------------

# Example 1: Development (minimal logging, no OpenTelemetry)
# LOG_LEVEL=DEBUG
# JSON_LOGGING=false
# ANALYTICS_ENABLED=false

# Example 2: Production (JSON logs, metrics, local Jaeger)
# LOG_LEVEL=INFO
# JSON_LOGGING=true
# ANALYTICS_ENABLED=true
# AUTH_TOKEN=abc123def456ghi789jkl012mno345pq
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_RESOURCE_ATTRIBUTES_ENVIRONMENT=production
# OTEL_RESOURCE_ATTRIBUTES_VERSION=1.0.0

# Example 3: Cloud deployment with Datadog
# LOG_LEVEL=INFO
# JSON_LOGGING=true
# ANALYTICS_ENABLED=true
# AUTH_TOKEN=abc123def456ghi789jkl012mno345pq
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.datadoghq.com
# OTEL_EXPORTER_OTLP_HEADERS=api-key=your-datadog-api-key
# OTEL_RESOURCE_ATTRIBUTES_ENVIRONMENT=production
# OTEL_RESOURCE_ATTRIBUTES_SERVICE=lorien-api
# OTEL_RESOURCE_ATTRIBUTES_VERSION=1.0.0

# Example 4: Cloud deployment with New Relic
# LOG_LEVEL=INFO
# JSON_LOGGING=true
# ANALYTICS_ENABLED=true
# AUTH_TOKEN=abc123def456ghi789jkl012mno345pq
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net:4317
# OTEL_EXPORTER_OTLP_HEADERS=api-key=your-new-relic-license-key
# OTEL_RESOURCE_ATTRIBUTES_ENVIRONMENT=production

# ----------------------------------------------------------------------------
# Security Notes
# ----------------------------------------------------------------------------
#
# 1. NEVER commit .env files to version control
# 2. Use strong, randomly generated AUTH_TOKEN values
# 3. Rotate tokens regularly in production
# 4. Restrict metrics endpoint access via firewall rules
# 5. Use TLS for all OTLP endpoints in production
# 6. Never log PHI (Protected Health Information)
#
# ----------------------------------------------------------------------------
